generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite no soporta enums: los valores permitidos están en src/lib/constants.ts

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         String // PATIENT | DOCTOR | CAREGIVER
  createdAt    DateTime @default(now())

  patientProfile   PatientProfile?   @relation("PatientUser")
  assignedPatients PatientProfile[]  @relation("AssignedDoctor")
  symptomLogs      SymptomLog[]      @relation("PatientLogs")
  loggedSymptoms   SymptomLog[]      @relation("LoggedBy")
  alerts           Alert[]
  caregivers       CaregiverLink[]   @relation("LinkPatient")
  caringFor        CaregiverLink[]   @relation("LinkCaregiver")
  caregiverInvites CaregiverInvite[]
}

// Vínculo paciente–cuidador. El paciente puede revocarlo en cualquier momento.
model CaregiverLink {
  id           String   @id @default(cuid())
  patientId    String
  patient      User     @relation("LinkPatient", fields: [patientId], references: [id], onDelete: Cascade)
  caregiverId  String
  caregiver    User     @relation("LinkCaregiver", fields: [caregiverId], references: [id], onDelete: Cascade)
  relationship String? // Ej: Hija, Pareja, Amigo
  createdAt    DateTime @default(now())

  @@unique([patientId, caregiverId])
}

// Código de invitación de un solo uso que el paciente comparte con su cuidador.
model CaregiverInvite {
  id        String    @id @default(cuid())
  code      String    @unique
  patientId String
  patient   User      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model PatientProfile {
  id            String  @id @default(cuid())
  userId        String  @unique
  user          User    @relation("PatientUser", fields: [userId], references: [id], onDelete: Cascade)
  diagnosis     String
  treatmentType String // CHEMOTHERAPY | RADIATION | SURGERY | IMMUNOTHERAPY | HORMONE_THERAPY | OTHER
  doctorId      String?
  doctor        User?   @relation("AssignedDoctor", fields: [doctorId], references: [id])
}

model SymptomLog {
  id            String   @id @default(cuid())
  patientId     String
  patient       User     @relation("PatientLogs", fields: [patientId], references: [id], onDelete: Cascade)
  // Quién hizo el registro: el propio paciente o un cuidador
  loggedById    String?
  loggedBy      User?    @relation("LoggedBy", fields: [loggedById], references: [id], onDelete: SetNull)
  painLevel     Int
  fever         Boolean
  temperature   Float?
  nauseaLevel   Int
  fatigueLevel  Int
  appetiteLevel Int
  notes         String?
  overallStatus String // GOOD | FAIR | POOR | CRITICAL
  loggedDate    DateTime @default(now())
  alerts        Alert[]

  @@index([patientId, loggedDate])
}

model Alert {
  id           String      @id @default(cuid())
  patientId    String
  patient      User        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  symptomLogId String?
  symptomLog   SymptomLog? @relation(fields: [symptomLogId], references: [id], onDelete: SetNull)
  severity     String // MEDIUM | HIGH | CRITICAL
  message      String
  status       String      @default("ACTIVE") // ACTIVE | RESOLVED
  createdAt    DateTime    @default(now())
  resolvedAt   DateTime?

  @@index([patientId, status])
}
